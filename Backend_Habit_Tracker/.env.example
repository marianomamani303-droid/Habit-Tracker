NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=habit_tracker_app
DB_PASSWORD=
DB_NAME=habit_tracker

# Genera un valor aleatorio de al menos 32 bytes. Nunca lo publiques.
JWT_SECRET=
# Duración en segundos: 86400 = 24 horas. Cookie y JWT duran lo mismo.
JWT_EXPIRES_SECONDS=86400
# Usa lax si frontend y API comparten sitio. none requiere HTTPS en producción.
COOKIE_SAME_SITE=lax

# Recuperación por correo. Sin SMTP_HOST y SMTP_FROM la API responde 503.
# 587 usa STARTTLS obligatorio; 465 requiere SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
